    {
      "LogName": "Rose Quartz to Refined Quartz",
      "Action": "EditData",
      "Target": "Data/Machines",
      "TargetField": [ "(BC)13", "OutputRules" ],
      "Entries": {
        "{{ModId}}.RoseQuartzToRefinedQuartz": {
          "Id": "{{ModId}}.RoseQuartzToRefinedQuartz",
          "Triggers": [
            {
              "Trigger": "ItemPlacedInMachine",
              "RequiredItemId": "(O){{ModId}}_RoseQuartz",
              "RequiredCount": 1
            }
          ],
          "UseFirstValidOutput": true,
          "OutputItem": [
            {
              "Id": "{{ModId}}.RoseQuartzRefinedQuartz",
              "ItemId": "(O)338",
              "MinStack": 2
            }
          ],
          "AdditionalConsumedItems": [
            {
              "ItemId": "(O)382",
              "RequiredCount": 1,
              "InvalidCountMessage": "{{i18n:machine.rose_quartz.missing_coal}}"
            }
          ],
          "MinutesUntilReady": 120,
          "DaysUntilReady": -1
        }
      }
    }
